# Security: on XAMPP the whole project folder sits under the web root (http://localhost/FPOS/).
# Only public/ may be served; .env, storage/ (logs, database backups), .git, vendor/, config and source are denied.
# public/.htaccess re-allows its own folder. Do not remove.
Options -Indexes
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
